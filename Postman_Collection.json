              "raw": "{\n  \"productId\": 1,\n  \"quantity\": 5,\n  \"totalPrice\": 7500.00,\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/orders/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "orders", "1"]
            }
          }
        },
        {
          "name": "Delete Order",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "http://localhost:8082/api/orders/1",
              "protocol": "http",
