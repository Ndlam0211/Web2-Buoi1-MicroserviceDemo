{
  "info": {
    "name": "Microservice Demo - Product & Order API",
    "description": "Collection for testing Product Service and Order Service APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Product Service",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Dell XPS 15\",\n  \"description\": \"High performance laptop with 16GB RAM and 512GB SSD\",\n  \"price\": 1500.00,\n  \"quantity\": 20\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8081/api/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8081/api/products/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "products", "1"]
            }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Dell XPS 15\",\n  \"description\": \"High performance laptop with 32GB RAM and 1TB SSD\",\n  \"price\": 1800.00,\n  \"quantity\": 15\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/products/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "products", "1"]
            }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "http://localhost:8081/api/products/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "products", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Order Service",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"quantity\": 3\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8082/api/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8082/api/orders/1",
              "protocol": "http",
